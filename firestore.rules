rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function allowed() { return signedIn() && exists(/databases/$(database)/documents/access/$(request.auth.token.email)); }

    // 허용 이메일 목록: 문서 ID = 이메일(소문자). 콘솔에서만 추가/삭제
    match /access/{email} {
      allow read: if signedIn() && request.auth.token.email == email;
      allow write: if false;
    }
    // 표시자 이름
    match /users/{uid} {
      allow read: if allowed();
      allow write: if allowed() && request.auth.uid == uid;
    }
    // 공정·구역·진척·도면
    match /{coll}/{docId} {
      allow read, write: if allowed() && coll != 'access' && coll != 'users';
    }
  }
}
